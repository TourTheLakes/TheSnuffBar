<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>The Snuff Bar | Admin</title>

  <style>
    :root{
      --bg:#321507;
      --fg:#F6C96B;
      --panel:#2a1106;
      --border:rgba(246,201,107,.35);
    }

    body{
      margin:0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background:var(--bg);
      color:var(--fg);
    }

    .wrap{
      max-width: 720px;
      margin: 0 auto;
      padding: 18px;
      box-sizing: border-box;
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
      padding:14px;
      background:var(--panel);
      border:1px solid var(--border);
      box-sizing:border-box;
    }

    .topbar .meta{
      font-size:14px;
      line-height:1.5;
    }

    .btn{
      background:transparent;
      color:var(--fg);
      border:1px solid var(--border);
      padding:10px 12px;
      cursor:pointer;
      font-size:14px;
    }

    h2{
      margin:18px 0 10px;
      letter-spacing:.08em;
    }

    .panel{
      padding:14px;
      background:var(--panel);
      border:1px solid var(--border);
      box-sizing:border-box;
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:6px;
      margin-bottom:10px;
    }

    label{
      font-size:14px;
      opacity:.95;
    }

    input, textarea{
      width:100%;
      box-sizing:border-box;
      padding:12px;
      border:1px solid var(--border);
      background:transparent;
      color:var(--fg);
      outline:none;
      border-radius:0; /* square */
      font-size:16px;
    }

    textarea{ min-height: 110px; resize: vertical; }

    .row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .row .col{
      flex:1 1 200px;
      min-width:200px;
    }

    .actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top: 8px;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .item{
      padding:12px;
      border:1px solid var(--border);
      background:transparent;
    }

    .item .title{
      font-weight:700;
      margin-bottom:6px;
    }

    .item .line{
      font-size:14px;
      line-height:1.45;
      opacity:.98;
    }

    .item .item-actions{
      display:flex;
      gap:10px;
      margin-top:10px;
    }

    .muted{ opacity:.75; }
    .hidden{ display:none; }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="topbar">
      <div class="meta">
        <div><strong>Logged in:</strong> <span id="who" class="muted">—</span></div>
        <div><strong>Auto logoff:</strong> <span id="countdown" class="muted">—</span></div>
        <div id="status" class="muted"></div>
      </div>
      <button id="btnLogout" class="btn">Logoff</button>
    </div>

    <h2>EVENTS</h2>

    <div class="panel">
      <div id="eventsList" class="list"></div>
      <div id="emptyList" class="muted hidden">No live events found.</div>
    </div>

    <h2>ADD / EDIT</h2>

    <div class="panel">
      <div class="row">
        <div class="col field">
          <label for="date">Date</label>
          <input id="date" type="date" />
        </div>
        <div class="col field">
          <label for="time">Time</label>
          <input id="time" type="time" />
        </div>
      </div>

      <div class="field">
        <label for="price">Price</label>
        <input id="price" type="text" placeholder="Optional" />
      </div>

      <div class="field">
        <label for="desc">Description</label>
        <textarea id="desc" placeholder="Optional"></textarea>
      </div>

      <div class="actions">
        <button id="btnSave" class="btn">Save</button>
        <button id="btnCancel" class="btn">Cancel edit</button>
      </div>

      <div id="formNote" class="muted" style="margin-top:10px;"></div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import {
      getAuth,
      GoogleAuthProvider,
      signInWithPopup,
      signOut,
      onAuthStateChanged
    } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

    import {
      getFirestore,
      collection,
      addDoc,
      doc,
      updateDoc,
      onSnapshot,
      query,
      where,
      orderBy,
      serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

    // --- PASTE YOUR EXISTING firebaseConfig HERE (unchanged) ---
    const firebaseConfig = {
      // apiKey: "...",
      // authDomain: "...",
      // projectId: "...",
      // etc...
    };

    const ALLOWED_EMAILS = new Set([
      "info@tourthelakes.com"
      // add 2 more later
    ]);

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    // UI
    const whoEl = document.getElementById("who");
    const countdownEl = document.getElementById("countdown");
    const statusEl = document.getElementById("status");
    const btnLogout = document.getElementById("btnLogout");

    const eventsList = document.getElementById("eventsList");
    const emptyList = document.getElementById("emptyList");

    const dateEl = document.getElementById("date");
    const timeEl = document.getElementById("time");
    const priceEl = document.getElementById("price");
    const descEl = document.getElementById("desc");
    const btnSave = document.getElementById("btnSave");
    const btnCancel = document.getElementById("btnCancel");
    const formNote = document.getElementById("formNote");

    // --- inactivity timer (10 mins) ---
    const INACTIVITY_MS = 10 * 60 * 1000;
    let lastActivity = Date.now();
    let tickTimer = null;

    function pad2(n){ return String(n).padStart(2,"0"); }
    function setStatus(msg){ statusEl.textContent = msg || ""; }

    function resetActivity(){
      lastActivity = Date.now();
    }

    function startCountdown(){
      stopCountdown();
      tickTimer = setInterval(() => {
        const left = Math.max(INACTIVITY_MS - (Date.now() - lastActivity), 0);
        const mm = Math.floor(left / 60000);
        const ss = Math.floor((left % 60000) / 1000);
        countdownEl.textContent = `${pad2(mm)}:${pad2(ss)}`;

        if (left <= 0) {
          doLogout();
        }
      }, 250);
    }

    function stopCountdown(){
      if (tickTimer) clearInterval(tickTimer);
      tickTimer = null;
      countdownEl.textContent = "—";
    }

    ["mousemove","mousedown","keydown","touchstart","scroll"].forEach(evt => {
      window.addEventListener(evt, resetActivity, { passive:true });
    });

    // --- auth gate ---
    async function ensureSignedIn(){
      const user = auth.currentUser;
      if (user) return user;

      const provider = new GoogleAuthProvider();
      const res = await signInWithPopup(auth, provider);
      return res.user;
    }

    async function doLogout(){
      try { await signOut(auth); } catch(e){}
      stopCountdown();
      whoEl.textContent = "—";
      setStatus("Signed out.");
      // immediate block: require sign-in again
      location.reload();
    }

    btnLogout.addEventListener("click", doLogout);

    // --- data model ---
    // events/{id} fields:
    // startAt: Date
    // dateText, timeText, price, description (all optional)
    // createdAt, createdBy, updatedAt, updatedBy
    // deletedAt, deletedBy (soft delete)

    function combineDateTime(dateStr, timeStr){
      if (!dateStr && !timeStr) return null;
      const d = dateStr || new Date().toISOString().slice(0,10);
      const t = timeStr || "00:00";
      // local time
      const dt = new Date(`${d}T${t}:00`);
      return isNaN(dt.getTime()) ? null : dt;
    }

    function clearForm(){
      dateEl.value = "";
      timeEl.value = "";
      priceEl.value = "";
      descEl.value = "";
      editingId = null;
      formNote.textContent = "";
    }

    function textOrNull(s){
      const v = (s || "").trim();
      return v.length ? v : null;
    }

    let editingId = null;

    btnCancel.addEventListener("click", () => clearForm());

    btnSave.addEventListener("click", async () => {
      const user = auth.currentUser;
      if (!user) return;

      if (!ALLOWED_EMAILS.has(user.email || "")) {
        setStatus("Not authorised.");
        return;
      }

      const dateStr = dateEl.value;
      const timeStr = timeEl.value;

      const startAt = combineDateTime(dateStr, timeStr);

      const payload = {
        // only include fields if set (so index can “ignore blanks” cleanly)
        ...(startAt ? { startAt } : {}),
        ...(textOrNull(dateStr) ? { dateText: dateStr } : {}),
        ...(textOrNull(timeStr) ? { timeText: timeStr } : {}),
        ...(textOrNull(priceEl.value) ? { price: textOrNull(priceEl.value) } : {}),
        ...(textOrNull(descEl.value) ? { description: textOrNull(descEl.value) } : {}),
        updatedAt: serverTimestamp(),
        updatedBy: user.email || null
      };

      try{
        if (editingId){
          await updateDoc(doc(db, "events", editingId), payload);
          formNote.textContent = "Saved changes.";
        } else {
          await addDoc(collection(db, "events"), {
            ...payload,
            createdAt: serverTimestamp(),
            createdBy: user.email || null,
            deletedAt: null,
            deletedBy: null
          });
          formNote.textContent = "Saved new event.";
        }
        clearForm();
      } catch(e){
        setStatus("Save failed.");
      }
    });

    async function softDelete(id){
      const user = auth.currentUser;
      if (!user) return;

      try{
        await updateDoc(doc(db, "events", id), {
          deletedAt: serverTimestamp(),
          deletedBy: user.email || null,
          updatedAt: serverTimestamp(),
          updatedBy: user.email || null
        });
      } catch(e){
        setStatus("Delete failed.");
      }
    }

    function fillFormFromDoc(d){
      const data = d.data();

      dateEl.value = data.dateText || "";
      timeEl.value = data.timeText || "";
      priceEl.value = data.price || "";
      descEl.value = data.description || "";

      editingId = d.id;
      formNote.textContent = `Editing: ${d.id}`;
      // keep them “active”
      resetActivity();
    }

    function formatLine(label, value){
      if (!value) return "";
      return `<div class="line"><strong>${label}:</strong> ${escapeHtml(value)}</div>`;
    }

    function escapeHtml(s){
      return String(s)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
    }

    function renderList(docs){
      eventsList.innerHTML = "";
      if (!docs.length){
        emptyList.classList.remove("hidden");
        return;
      }
      emptyList.classList.add("hidden");

      docs.forEach(d => {
        const data = d.data();

        const dateText = data.dateText || "";
        const timeText = data.timeText || "";
        const price = data.price || "";
        const desc = data.description || "";

        const wrapper = document.createElement("div");
        wrapper.className = "item";

        wrapper.innerHTML = `
          <div class="title">${escapeHtml(desc || "Event")}</div>
          ${formatLine("Date", dateText)}
          ${formatLine("Time", timeText)}
          ${formatLine("Price", price)}
          <div class="item-actions">
            <button class="btn" data-action="edit">Amend</button>
            <button class="btn" data-action="delete">Delete</button>
          </div>
        `;

        wrapper.querySelector('[data-action="edit"]').addEventListener("click", () => fillFormFromDoc(d));
        wrapper.querySelector('[data-action="delete"]').addEventListener("click", () => softDelete(d.id));

        eventsList.appendChild(wrapper);
      });
    }

    let unsub = null;

    function subscribeEvents(){
      if (unsub) unsub();

      // “live events already added” = non-deleted only, ordered by date
      const qy = query(
        collection(db, "events"),
        where("deletedAt", "==", null),
        orderBy("startAt", "asc")
      );

      unsub = onSnapshot(qy, (snap) => {
        renderList(snap.docs);
      });
    }

    onAuthStateChanged(auth, async (user) => {
      try{
        if (!user){
          setStatus("Signing in...");
          user = await ensureSignedIn();
        }

        // hard block if not allowed
        const email = user.email || "";
        whoEl.textContent = email || "—";

        if (!ALLOWED_EMAILS.has(email)){
          setStatus("Not authorised for admin.");
          await doLogout();
          return;
        }

        setStatus("");
        resetActivity();
        startCountdown();
        subscribeEvents();
      } catch(e){
        setStatus("Auth failed.");
      }
    });
  </script>
</body>
</html>
